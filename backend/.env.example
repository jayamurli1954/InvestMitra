# ============================================================================
# INVESTMENT FRAMEWORK - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it's already in .gitignore
# ============================================================================

# ============================================================================
# SECURITY - JWT Authentication
# ============================================================================
# Generate a secure random key using:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your-secret-key-here-replace-with-generated-key

# ============================================================================
# DATABASE - MongoDB Configuration
# ============================================================================
# MongoDB connection URL
# Local: mongodb://localhost:27017
# Cloud: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=investment_framework

# ============================================================================
# EMAIL - SMTP Configuration (for password reset emails)
# ============================================================================
# SMTP server (Gmail example shown)
SMTP_SERVER=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your email address
SMTP_EMAIL=your-email@gmail.com

# Your email password or app-specific password
# For Gmail: https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-app-specific-password

# Sender name displayed in emails
SENDER_NAME=InvestMitra

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Frontend URL (used in password reset emails and CORS)
# Development: http://localhost:3500
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3500

# Runtime environment
# development | staging | production
ENVIRONMENT=development

# Comma-separated allowed CORS origins
# Example: https://investmitra.vercel.app,https://app.investmitra.com
CORS_ORIGINS=http://localhost:3500

# ============================================================================
# AI SERVICES - Google Gemini API
# ============================================================================
# Google Gemini API Key for AI insights
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
