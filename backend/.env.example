# ============================================================================
# INVESTMITRA - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it's already in .gitignore
# ============================================================================

# ============================================================================
# SECURITY - JWT Authentication
# ============================================================================
# Generate a secure random key using:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your-secret-key-here-replace-with-generated-key

# production | development — production enforces required secrets at startup
APP_ENV=development

# ============================================================================
# DATABASE - MongoDB Configuration
# ============================================================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=investment_framework

# Backend listen port (default 9001)
BACKEND_PORT=9001
BACKEND_HOST=127.0.0.1

# ============================================================================
# EMAIL - Brevo (forgot-password only — no Gmail SMTP password needed)
# ============================================================================
# 1. Brevo → Settings → SMTP & API → API keys & MCP → Generate API key
# 2. Brevo → Settings → Senders, domains, IPs → add & verify sender email
# 3. Set BREVO_API_KEY + SMTP_EMAIL below, then restart backend
BREVO_API_KEY=your-brevo-api-key-here
SMTP_EMAIL=your-verified-sender@gmail.com
SENDER_NAME=InvestMitra

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# React UI URL (port 3000) — used in reset links inside emails
FRONTEND_URL=http://localhost:3000

# ============================================================================
# AI SERVICES - Google Gemini API (optional — AI insights only)
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# OPTIONAL - Development / security toggles
# ============================================================================
SEED_TEST_USER=false
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_DEV_FEATURES=false
